LOG_LEVEL=INFO
LABY_MODEL=deepseek/deepseek-v4-flash
LABY_VISION_MODEL=google/gemini-2.5-flash
LABY_TURN_TIMEOUT=120
LABY_HISTORY_TURNS=12
NODE_INTERNAL_BASE_URL=https://app.dentnode.com/api
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://ai.dentnode.com
OPENROUTER_APP_NAME=DentNode Laby
D10_INTERNAL_BASE_URL=https://d10.live/api
D10_AGENT_MODEL=deepseek/deepseek-v4-flash
D10_AGENT_TIMEOUT_SECS=120
D10_AGENT_MAX_MODEL_CALLS=8
D10_USAGE_FLUSH_INTERVAL_SECS=10
D10_USAGE_BATCH_SIZE=100
SCAN_REVIEW_VISION_MODEL=qwen/qwen3-vl-32b-instruct
SCAN_REVIEW_MODEL=qwen/qwen3-vl-32b-instruct
SCAN_REVIEW_ENABLE_LLM=true
SCAN_REVIEW_LLM_TIMEOUT=90
SCAN_REVIEW_MAX_BYTES=83886080
SCAN_REVIEW_MAX_FILES=8
SCAN_REVIEW_FETCH_TIMEOUT=60
SCAN_REVIEW_ANALYZE_TIMEOUT=120
SCAN_REVIEW_MAX_FACES=5000000
SCAN_REVIEW_ALLOWED_HOSTS=storage.googleapis.com
SCAN_REVIEW_ALLOW_INSECURE_FETCH=false
AUDIO_TO_TEXT_MODEL=microsoft/mai-transcribe-2
AUDIO_TO_TEXT_TIMEOUT_SECS=120
AUDIO_TO_TEXT_MAX_BYTES=26214400
CALL_AUDIO_REQUEST_MAX_BYTES=27000000
AUDIO_TO_TEXT_FETCH_TIMEOUT_SECS=30
AUDIO_TO_TEXT_ALLOWED_HOSTS=.digitaloceanspaces.com,.cdn.digitaloceanspaces.com
AUDIO_TO_TEXT_ALLOW_INSECURE_FETCH=false
TEXT_TO_SPEECH_MODEL=openai/gpt-audio-mini
TEXT_TO_SPEECH_VOICE=alloy
TEXT_TO_SPEECH_TIMEOUT_SECS=120
TEXT_TO_SPEECH_MAX_CHARS=4000

# OpenTelemetry tracing is exported over the private dentnode-telemetry Docker
# network. The endpoint/service identity are enforced by compose.yaml; this is
# the production head-sampling ratio (parent decisions are always honored).
OTEL_TRACES_SAMPLER_ARG=0.10
