# ── Laby ADK agent service (Python) ─────────────────────────────────────
# Port the FastAPI app listens on (Cloud Run injects PORT=8080).
PORT=8080

# Logging level: INFO (default) or DEBUG for local development.
LOG_LEVEL=INFO

# Maximum seconds a single agent turn may run before timing out.
LABY_TURN_TIMEOUT=120

# ── LLM: OpenRouter ONLY ─────────────────────────────────────────────────
# All generation goes through OpenRouter (BYOK): provider credentials live in
# the OpenRouter dashboard, so this service needs exactly one key. Never add a
# provider API key (DeepSeek/OpenAI/Anthropic/…) here.
#
# LABY_MODEL is an OpenRouter model id; the litellm "openrouter/" route prefix
# is added automatically. Must support FUNCTION CALLING — the agent is entirely
# tool-driven. Do NOT use deepseek/deepseek-r1 (no tool calling).
LABY_MODEL=deepseek/deepseek-v4-flash

# Model used by VISION features (case-from-image, scan review). Must accept
# image input — the tool-calling text model above generally cannot see images.
LABY_VISION_MODEL=google/gemini-2.5-flash

OPENROUTER_API_KEY=
# Optional: only set to point at an OpenRouter-compatible proxy.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Optional attribution on OpenRouter's activity dashboard.
OPENROUTER_SITE_URL=https://ai.dentnode.com
OPENROUTER_APP_NAME=DentNode Laby

# Service-to-service auth. The Node backend calls THIS service with this key,
# and this service calls Node's /internal/laby-tools/* with the SAME key.
# Must equal INTERNAL_API_KEY in the Node backend (app.dentnode.com) env.
INTERNAL_API_KEY=

# Base URL of the Node backend API (note the /api mount prefix).
# Local docker-compose: http://node:3000/api
# Cloud Run:            https://app.dentnode.com/api
NODE_INTERNAL_BASE_URL=http://localhost:3000/api

# How many recent thread turns to load as short-term memory.
LABY_HISTORY_TURNS=12

# ── Cross-service parity (NOT consumed by this Python service) ────────────
# Kept for env consistency across both codebases. The agent does not call
# itself, and Redis (cache/rate-limit) lives in the Node backend.
LABY_AGENT_URL=http://localhost:8080
REDIS_URL=
