# ── Laby ADK agent service (Python) ─────────────────────────────────────
# Port the FastAPI app listens on (the container defaults to 8080).
PORT=8080

# Logging level: INFO (default) or DEBUG for local development.
LOG_LEVEL=INFO

# Maximum seconds a single agent turn may run before timing out.
LABY_TURN_TIMEOUT=120

# Optional outside the VPS. Leaving this blank disables tracing. Production
# compose pins it to the private collector and samples 10% of root traces.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=ai.dentnode.com
OTEL_SERVICE_VERSION=local
OTEL_TRACES_SAMPLER_ARG=0.10

# ── LLM: OpenRouter ONLY ─────────────────────────────────────────────────
# All generation goes through OpenRouter (BYOK): provider credentials live in
# the OpenRouter dashboard, so this service needs exactly one key. Never add a
# provider API key (DeepSeek/OpenAI/Anthropic/…) here.
#
# LABY_MODEL is an OpenRouter model id; the litellm "openrouter/" route prefix
# is added automatically. Must support FUNCTION CALLING — the agent is entirely
# tool-driven. Do NOT use deepseek/deepseek-r1 (no tool calling).
LABY_MODEL=deepseek/deepseek-v4-flash

# Model used by VISION features (case-from-image, rejected-cases). Must accept
# image input — the tool-calling text model above generally cannot see images.
LABY_VISION_MODEL=google/gemini-2.5-flash

# Vision model for the SCAN REVIEW only (agent/scan_review.py — the review of
# rendered arch images). Kept separate from LABY_VISION_MODEL so scan review can
# be tuned without changing case-from-image or rejected-cases. Falls back to
# LABY_VISION_MODEL if unset.
SCAN_REVIEW_VISION_MODEL=qwen/qwen3-vl-32b-instruct

OPENROUTER_API_KEY=
# Optional: only set to point at an OpenRouter-compatible proxy.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Optional attribution on OpenRouter's activity dashboard.
OPENROUTER_SITE_URL=https://ai.dentnode.com
OPENROUTER_APP_NAME=DentNode Laby

# Service-to-service auth. The Node backend calls THIS service with this key,
# and this service calls Node's /internal/laby-tools/* with the SAME key.
# Must equal INTERNAL_API_KEY in the Node backend (app.dentnode.com) env.
INTERNAL_API_KEY=

# Base URL of the Node backend API (note the /api mount prefix).
# Local docker-compose: http://node:3000/api
# VPS production:       https://app.dentnode.com/api
NODE_INTERNAL_BASE_URL=http://localhost:3000/api

# ── D10.live WhatsApp Agent ──────────────────────────────────────────────
# D10 calls POST /d10/agent/run with x-d10-internal-key. This service calls
# D10's internal tool and usage-event endpoints using the same key. During
# migration D10_INTERNAL_KEY falls back to INTERNAL_API_KEY when left unset.
D10_INTERNAL_KEY=
CALLING_VOICE_INTERNAL_KEY=
D10_INTERNAL_BASE_URL=http://localhost:3000/api

# OpenRouter model used only by the D10 Agent. Must support function calling.
# Falls back to LABY_MODEL when empty.
D10_AGENT_MODEL=deepseek/deepseek-v4-flash
D10_AGENT_TIMEOUT_SECS=120
D10_AGENT_MAX_MODEL_CALLS=8

# SQLite usage outbox. Every provider call is committed here before its result
# is acted on. In a container this must be a path the non-root runtime user can
# write. It is a crash buffer, not
# durable storage — the shutdown hook flushes it on SIGTERM.
D10_USAGE_OUTBOX_PATH=.data/d10-usage-outbox.sqlite3
D10_USAGE_FLUSH_INTERVAL_SECS=10
D10_USAGE_BATCH_SIZE=100

# How many recent thread turns to load as short-term memory.
LABY_HISTORY_TURNS=12

# ── Scan Review (standalone mesh QA module) ───────────────────────────────
# Reviews raw STL/PLY/OBJ URLs for holes and topology defects. NOT part of
# Laby — separate namespace, separate model, separate limits.
# All optional: the defaults below are what the module uses if unset.

# Model for the narrative layer. The input is measured JSON, not images, so
# this does NOT need a vision model. Falls back to LABY_MODEL if unset.
SCAN_REVIEW_MODEL=qwen/qwen3-vl-32b-instruct

# Set false to return geometry only — deterministic, free, no OpenRouter call.
SCAN_REVIEW_ENABLE_LLM=true
SCAN_REVIEW_LLM_TIMEOUT=90

# Fetch limits. These are SECURITY controls, not just perf knobs: this module
# is the only one in the service that dereferences a caller-supplied URL.
SCAN_REVIEW_MAX_BYTES=83886080
SCAN_REVIEW_MAX_FILES=8
SCAN_REVIEW_FETCH_TIMEOUT=60
SCAN_REVIEW_ANALYZE_TIMEOUT=120
SCAN_REVIEW_MAX_FACES=5000000

# STRONGLY RECOMMENDED IN PRODUCTION. Comma-separated hosts the module may
# fetch from — normally just the bucket/CDN holding scans. A leading dot marks
# a suffix match (".dentnode.com"). Empty means any public host is allowed,
# which leaves only the private-IP checks between us and an SSRF attempt.
SCAN_REVIEW_ALLOWED_HOSTS=

# LOCAL DEV ONLY. Allows http:// and private/loopback mesh URLs. Enabling this
# in a deployed environment exposes the GCP metadata server. The service logs a
# WARNING at startup when it is on.
SCAN_REVIEW_ALLOW_INSECURE_FETCH=false

# ── Audio-to-Text agent (shared app.dentnode.com + d10.live) ─────────────
# Transcribes a Digital Ocean audio URL and optionally summarises it. Shared by
# both services: app.dentnode.com calls with x-internal-key, d10.live with
# x-d10-internal-key. Accepts Digital Ocean URLs only.

# Speech-to-text model, called through OpenRouter's /audio/transcriptions
# endpoint (not Chat Completions). It must be a transcription model that returns
# `verbose_json` with timestamped segments; `microsoft/mai-transcribe-2` also
# exposes Azure diarization, which is what puts recording-local speaker ids on
# those segments. Swapping in a model without diarization still transcribes —
# the response simply carries no speaker labels.
AUDIO_TO_TEXT_MODEL=microsoft/mai-transcribe-2
AUDIO_TO_TEXT_TIMEOUT_SECS=120

# Fetch limits. These are SECURITY controls: this endpoint dereferences a
# caller-supplied Digital Ocean URL (SSRF surface), like Scan Review.
# The same byte cap also bounds multipart uploads to
# POST /internal/call-audio/analyze.
AUDIO_TO_TEXT_MAX_BYTES=26214400
# Total multipart bytes, including boundaries/form fields. Must be larger than
# AUDIO_TO_TEXT_MAX_BYTES and remain within the production proxy's 27 MB cap.
CALL_AUDIO_REQUEST_MAX_BYTES=27262976
AUDIO_TO_TEXT_FETCH_TIMEOUT_SECS=30

# Comma-separated hosts the endpoint may fetch audio from. Defaults to Digital
# Ocean Spaces (origin + CDN); a leading dot marks a suffix match.
AUDIO_TO_TEXT_ALLOWED_HOSTS=.digitaloceanspaces.com,.cdn.digitaloceanspaces.com

# LOCAL DEV ONLY. Permits http:// and private/loopback audio URLs (e.g. a local
# sample file). Never enable in a deployed environment.
AUDIO_TO_TEXT_ALLOW_INSECURE_FETCH=false

# ── Text-to-Speech agent (open to every trusted internal caller) ──────────
# POST /text-to-speech turns text into spoken audio and streams the bytes back.
# Nothing is stored here — the calling application owns the file.

# The model must emit the `audio` output modality. Of 430 models in the
# OpenRouter catalog only four do: two Lyria models (music, not speech) and
# openai/gpt-audio / openai/gpt-audio-mini. There is NO free speech model to
# fall back to. The mini variant is 26.7x cheaper per audio output token
# ($0.0000024 vs $0.000064) — about $0.0043 per minute of speech — so changing
# this is a spend decision, not a preference.
TEXT_TO_SPEECH_MODEL=openai/gpt-audio-mini

# Default when the caller does not pass `voice`. One of: alloy, ash, ballad,
# cedar, coral, echo, fable, marin, nova, onyx, sage, shimmer, verse.
TEXT_TO_SPEECH_VOICE=alloy

# Bounds the gap between streamed chunks, not the length of the utterance.
TEXT_TO_SPEECH_TIMEOUT_SECS=120

# COST CONTROL. Audio output is billed per second of speech, so the character
# cap is what bounds the spend of any single call.
TEXT_TO_SPEECH_MAX_CHARS=4000

# ── Cross-service parity (NOT consumed by this Python service) ────────────
# Kept for env consistency across both codebases. The agent does not call
# itself, and Redis (cache/rate-limit) lives in the Node backend.
LABY_AGENT_URL=http://localhost:8080
REDIS_URL=
